rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid));
    }

    function userExists() {
      return signedIn() && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid));
    }

    function isActive() {
      return userExists() && userDoc().data.activo == true;
    }

    function isAdmin() {
      return isActive() && userDoc().data.role == 'admin';
    }

    function isSupervisor() {
      return isActive() && userDoc().data.role == 'supervisor';
    }

    function canManagePayments() {
      return isAdmin() || isSupervisor();
    }

    function isCollector() {
      return isActive() && (userDoc().data.role == 'cobrador');
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAssignedToMe() {
      return signedIn() && resource.data.assignedToUid == request.auth.uid;
    }

    function newAssignedToMe() {
      return signedIn() && request.resource.data.assignedToUid == request.auth.uid;
    }

    function isCreatedByMe() {
      return signedIn() && resource.data.usuarioUid == request.auth.uid;
    }

    function newCreatedByMe() {
      return signedIn() && request.resource.data.usuarioUid == request.auth.uid;
    }

    function hasValidMoney(fieldName) {
      return request.resource.data[fieldName] is number && request.resource.data[fieldName] >= 0;
    }

    match /usuarios/{userId} {
      allow read: if isAdmin() || isOwner(userId);

      allow create: if signedIn() && isOwner(userId);

      allow update: if isAdmin()
        && !(isOwner(userId) && request.resource.data.activo == false)
        && request.resource.data.role in ['admin', 'supervisor', 'cobrador'];

      allow delete: if false;
    }

    match /clientes/{clienteId} {
      allow read: if isAdmin() || isAssignedToMe();

      allow create: if isAdmin() || (
        isCollector()
        && newAssignedToMe()
        && request.resource.data.nombre is string
        && request.resource.data.telefono is string
      );

      allow update: if isAdmin() || (
        isCollector()
        && isAssignedToMe()
        && newAssignedToMe()
      );

      allow delete: if false;
    }

    match /creditos/{creditoId} {
      allow read: if isAdmin() || isAssignedToMe();

      allow create: if isAdmin() || (
        isCollector()
        && newAssignedToMe()
        && hasValidMoney('valorPrestado')
        && hasValidMoney('valorTotal')
        && hasValidMoney('saldoPendiente')
        && request.resource.data.numeroCuotas is number
        && request.resource.data.numeroCuotas > 0
      );

      allow update: if isAdmin() || (
        isCollector()
        && isAssignedToMe()
        && newAssignedToMe()
        && hasValidMoney('saldoPendiente')
      );

      allow delete: if false;
    }

    match /pagos/{pagoId} {
      allow read: if isAdmin()
        || resource.data.assignedToUid == request.auth.uid
        || resource.data.usuarioUid == request.auth.uid;

      allow create: if isAdmin() || (
        isCollector()
        && (
          request.resource.data.assignedToUid == request.auth.uid
          || request.resource.data.usuarioUid == request.auth.uid
        )
        && hasValidMoney('valorPagado')
        && request.resource.data.valorPagado > 0
      );

      allow update: if canManagePayments();

      allow delete: if false;
    }

    match /gastos/{gastoId} {
      allow read: if isAdmin()
        || resource.data.usuarioUid == request.auth.uid
        || resource.data.createdByUid == request.auth.uid;

      allow create: if isAdmin() || (
        isCollector()
        && (
          request.resource.data.usuarioUid == request.auth.uid
          || request.resource.data.createdByUid == request.auth.uid
        )
        && hasValidMoney('valor')
      );

      allow update: if isAdmin()
        || resource.data.usuarioUid == request.auth.uid
        || resource.data.createdByUid == request.auth.uid;

      allow delete: if false;
    }

    match /rutas/{rutaId} {
      allow read: if isActive();
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    match /visitas/{visitaId} {
      allow read: if isAdmin() || isAssignedToMe();

      allow create: if isAdmin() || (
        isCollector()
        && newAssignedToMe()
      );

      allow update: if isAdmin() || (
        isCollector()
        && isAssignedToMe()
        && newAssignedToMe()
      );

      allow delete: if false;
    }

    match /cierresCaja/{cierreId} {
      allow read: if isAdmin()
        || resource.data.usuarioUid == request.auth.uid;

      allow create: if isAdmin() || (
        isCollector()
        && request.resource.data.usuarioUid == request.auth.uid
      );

      allow update: if canManagePayments();

      allow delete: if false;
    }

    match /cashClosings/{cierreId} {
      allow read: if isAdmin()
        || resource.data.usuarioUid == request.auth.uid;

      allow create: if isAdmin() || (
        isCollector()
        && request.resource.data.usuarioUid == request.auth.uid
      );

      allow update: if canManagePayments();

      allow delete: if false;
    }

    match /configuracion/{configId} {
      allow read: if isActive();
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    match /businessSettings/{configId} {
      allow read: if isActive();
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    match /auditoria/{auditId} {
      allow read: if isAdmin();

      allow create: if isActive();

      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}