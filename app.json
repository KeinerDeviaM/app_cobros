{
    "expo":  {
                 "name":  "CobroApp",
                 "slug":  "app-cobros",
                 "version":  "1.0.9",
                 "orientation":  "portrait",
                 "platforms":  [
                                   "android"
                               ],
                 "userInterfaceStyle":  "light",
