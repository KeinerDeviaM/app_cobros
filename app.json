                                       }
                           },
                 "owner":  "keiner_devia",
                 "notification":  {
                                      "icon":  "./assets/notification-icon.png",
                                      "color":  "#2563EB"
                                  },
                 "plugins":  [
                                 "expo-notifications"
                             ]
             }
}