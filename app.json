                                                      "backgroundColor":  "#2563EB"
                                                  },
                                 "permissions":  [
                                                     "INTERNET",
                                                     "ACCESS_NETWORK_STATE",
                                                     "POST_NOTIFICATIONS"
                                                 ]
                             },
                 "extra":  {
                               "eas":  {
